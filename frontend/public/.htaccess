<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /handicap/

  # Plain http:// was serving the site directly with no redirect at all --
  # browsers correctly flag that as "Not Secure" since it's genuinely
  # unencrypted, even though the https:// version works fine. Force it here
  # instead of relying on every visitor typing https:// themselves.
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# index.html has to always be re-checked with the server -- it's what points
# at the current build's hashed JS/CSS filenames, so caching it (even
# briefly) means an old visit can flash the previous version before a
# background revalidation swaps in the current one. The hashed files under
# /assets/ are safe to cache forever instead, since a new build always gets
# new filenames rather than overwriting old content.
<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
</IfModule>
