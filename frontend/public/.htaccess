<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /handicap/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# index.html has to always be re-checked with the server -- it's what points
# at the current build's hashed JS/CSS filenames, so caching it (even
# briefly) means an old visit can flash the previous version before a
# background revalidation swaps in the current one. The hashed files under
# /assets/ are safe to cache forever instead, since a new build always gets
# new filenames rather than overwriting old content.
<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
</IfModule>
